# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى git.

# --- Django ---
MY_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# يقبل اسم النطاق أو origin كامل
MAIN_DOMAIN=https://bookmark.deplois.net
# اختياري (افتراضيًا يُشتق من MAIN_DOMAIN)
# ALLOWED_HOSTS=bookmark.deplois.net,localhost
# CSRF_TRUSTED_ORIGINS=https://bookmark.deplois.net
# فعّلها فقط إن كان الموقع خلف HTTPS بالكامل
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=False

# --- PostgreSQL ---
POSTGRES_DB=maktaba
POSTGRES_USER=maktaba
POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --- Optional ---
# REDIS_URL=redis://redis:6379/0
# HTTP_PORT=80
# LOG_LEVEL=INFO

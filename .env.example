# تُولَّد تلقائيًا إن تُركت فارغة (تؤخذ فقط عند أول إنشاء لقاعدة البيانات)
# POSTGRES_PASSWORD=
# LOG_LEVEL=INFO
# محليًا: منفذ docker-compose.local.yml
# LOCAL_PORT=8000
